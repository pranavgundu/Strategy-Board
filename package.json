{
  "name": "strategy-board",
  "version": "2026.6.0",
  "description": "The Digital Strategy Whiteboard for FRC",
  "packageManager": "bun@1.2.5",
  "homepage": "https://github.com/pranavgundu/Strategy-Board",
  "author": {
    "name": "Pranav Gundu",
    "email": "pranav@strategyboard.app"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview --host",
    "spell": "cspell \"**/*.{ts,tsx,js,jsx,html,md}\"",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "assets": "cp favicon/icon-512.png assets/icon.png && cp favicon/icon-512.png assets/icon-only.png && magick favicon/icon-512.png -define icon:auto-resize=256,48,32,16 favicon/favicon.ico && bunx tauri icon favicon/icon-512.png",
    "wasm:build": "wasm-pack build crates/strategy-core --release --target web --out-dir ../../src/wasm/pkg --out-name strategy_core && rm -f src/wasm/pkg/.gitignore",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:mac": "tauri build --target universal-apple-darwin",
    "tauri:build:win": "tauri build --target x86_64-pc-windows-msvc",
    "tauri:build:linux": "tauri build --target x86_64-unknown-linux-gnu",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "ios:open": "tauri ios dev --open",
    "ios:build": "tauri ios build",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:open": "tauri android dev --open",
    "android:build": "tauri android build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/marked": "^6.0.0",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "cspell": "^10.0.0",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
  },
  "ignoredBuiltDependencies": [
    "@firebase/util",
    "core-js",
    "esbuild",
    "protobufjs"
  ],
  "overrides": {
    "tar": ">=7.5.8",
    "minimatch": ">=10.2.1",
    "serialize-javascript": ">=7.0.3"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "es-abstract": "^1.24.2",
    "firebase": "^12.16.0",
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "marked": "^18.0.7",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.3",
    "uuid": "^14.0.1"
  }
}
